rules_version = '2';

// Reglas de seguridad de Firebase Storage para NutriMotion.
//
// La app sube fotos de perfil a: profile_photos/{uid}.jpg
// (ver profile_screen.dart → _pickImage).
//
// - Escritura: solo el dueño, solo imágenes, máx. 5 MB.
// - Lectura: solo el dueño. La app muestra la foto vía download URL con
//   token, que no pasa por estas reglas, así que esto no rompe nada.
//   Si en el futuro hay feed/comunidad, relajar a usuarios autenticados.
//
// Desplegar con: firebase deploy --only storage
// (o pegar en Firebase Console → Storage → Reglas)
service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{fileName} {
      allow read: if request.auth != null
                  && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Cualquier otra ruta: denegada explícitamente.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
